[Unit]
Description=Portfolio Studio
After=network.target minio.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/portfolio-app
ExecStart=/usr/bin/java -Xms256m -Xmx768m -jar /home/deploy/portfolio-app/portfolio.war
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
EnvironmentFile=-/etc/portfolio.env

[Install]
WantedBy=multi-user.target
