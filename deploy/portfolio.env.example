# Copy to /etc/portfolio.env on the server (mode 600). Do not commit the real file.
# systemd reads this via EnvironmentFile in deploy/portfolio.service.

SERVER_FORWARD_HEADERS_STRATEGY=native
SERVER_SERVLET_SESSION_COOKIE_SECURE=true
SERVER_SERVLET_SESSION_COOKIE_SAMESITE=lax

# Used only when cms_users is empty (first boot).
PORTFOLIO_SEED_OWNER_USERNAME=change-me
PORTFOLIO_SEED_OWNER_PASSWORD=change-me

# Optional MinIO on this box (127.0.0.1 only). Leave unset to keep disk uploads.
# Use the scoped app user from /etc/minio-app.env (provision-minio-app.sh).
# Do not use MINIO_ROOT_USER / MINIO_ROOT_PASSWORD here.
# Loopback HTTP only — Java rejects non-loopback HTTP. MinIO is not on the public network.
# PORTFOLIO_STORAGE_S3_ENABLED=true
# PORTFOLIO_STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
# PORTFOLIO_STORAGE_S3_ACCESS_KEY=portfolio-app
# PORTFOLIO_STORAGE_S3_SECRET_KEY=
# PORTFOLIO_STORAGE_S3_BUCKET=portfolio-uploads
# PORTFOLIO_STORAGE_S3_REGION=us-east-1
# PORTFOLIO_STORAGE_S3_MIGRATE=false
# PORTFOLIO_STORAGE_S3_DELETE_LOCAL_AFTER_VERIFY=false
