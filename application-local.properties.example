# Copy to application-local.properties in the project root (gitignored).
# Used only when cms_users is empty (first local boot).
# Do not reuse these values on the live server.
portfolio.seed.owner.username=local-dev
portfolio.seed.owner.password=local-password

# Optional MinIO (off unless enabled AND endpoint/bucket/keys are set).
# New uploads then go to MinIO only. Public URLs stay /uploads/...
# portfolio.storage.s3.enabled=true
# portfolio.storage.s3.endpoint=http://127.0.0.1:9000
# portfolio.storage.s3.access-key=
# portfolio.storage.s3.secret-key=
# portfolio.storage.s3.bucket=portfolio-uploads
# portfolio.storage.s3.region=us-east-1
# Copy disk -> MinIO, keep disk. Turn off after the run.
# portfolio.storage.s3.migrate=true
# After you check gallery/work/blog, delete disk copies that exist in MinIO. Then turn off.
# portfolio.storage.s3.delete-local-after-verify=true
